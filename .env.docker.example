# ===================================================
# Cadence CX (Knowmon) Docker Environment Variables
# ===================================================

# Port Configurations
FRONTEND_PORT=3001
BACKEND_PORT=8050
MONGO_PORT=27017

# MongoDB Configuration
DB_NAME=knowmon

# Application & Auth Secrets
EMERGENT_LLM_KEY=sk-local-dev-key
ADMIN_EMAIL=admin@jswshakti.in
LDAP_JWT_SECRET=super-secret-ldap-jwt-key-for-local-dev-12345
CORS_ORIGINS=*

# Optional: Active Directory / LDAP Integration
# LDAP_URL=ldap://192.168.1.10:389
# LDAP_BASE_DN=dc=corp,dc=local
# LDAP_BIND_DN=cn=ServiceAccount,ou=Users,dc=corp,dc=local
# LDAP_BIND_PASSWORD=SecretPassword123
# LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP_TEAM_LEAD_GROUP_DN=cn=TeamLeads,ou=Groups,dc=corp,dc=local

# Optional: SMTP / Email Integration
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=notifications@mycompany.com
# SMTP_PASSWORD=EmailAppPassword
# SMTP_FROM="Cadence CX" <notifications@mycompany.com>
